<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="32dp"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/shopee_display"
        android:gravity="center"
        android:text="@string/delete_account_dialog_title"
        android:textColor="#E53935"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/delete_account_dialog_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Password Input Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeletePassword"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:hintEnabled="false"
        app:boxStrokeColor="@color/dark_green"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="#8F8E8A">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtDeletePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- "Xác nhận xóa" button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/delete_account"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#E53935"
        app:cornerRadius="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <!-- "Hủy" button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelDelete"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="#41413F"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:strokeColor="#DDD8D2"
        app:strokeWidth="1.5dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>
